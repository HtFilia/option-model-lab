api.pricing.lucaslebihan.dev {
	encode zstd gzip

	# Requires Caddy 2.10 or newer. Pydantic also enforces semantic work limits.
	request_body {
		max_size 64KB
	}

	reverse_proxy 127.0.0.1:8000 {
		health_uri /health
		health_interval 30s
		transport http {
			dial_timeout 2s
			response_header_timeout 30s
		}
	}
}
